#!/bin/sh

set -e

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"

color() {
    _color="$1"
    _text="$2"

    case "$_color" in
        (red)    code="31" ;;
        (green)  code="32" ;;
        (yellow) code="33" ;;
        (blue)   code="34" ;;
        (purple) code="35" ;;
        (cyan)   code="36" ;;
        (white)  code="37" ;;
        (black)  code="30" ;;
        (bold)   code="1"  ;;
        (reset)  code="0"  ;;
        (*)      code="0"  ;;
    esac
    printf "\033[%sm%s\033[0m" "$code" "$_text"
}

ensure_exec() {
  for script in "$PROJECT_DIR/caddy-reverse-proxy/runner" \
    "$PROJECT_DIR/fitness-web/runner" \
    "$PROJECT_DIR/fitness-api/run"; do
    if [ -f "$script" ]; then
      chmod +x "$script"
    fi
  done
}

help() {
  printf "Runner options:\n"
  printf "dev\t- (re)initialize development environment\n"
  printf "prod\t- (re)initialize production environment\n"
  printf "stop\t- shut down an environment\n"
  printf "destroy\t- remove environment\n"
  printf "help\t\t- show this message\n"
}

copy_env() {
  for dir in caddy-reverse-proxy fitness-web fitness-api/project fitness-api/dependencies; do
    cp .env "$dir/"
  done
}

stop() {
  (cd caddy-reverse-proxy && ./runner stop)
  (cd fitness-web && ./runner stop)
  (cd fitness-api/dependencies && docker compose down)
}

destroy() {
  (cd caddy-reverse-proxy && ./runner destroy)
  (cd fitness-web && ./runner destroy)
  (cd fitness-api/dependencies && docker compose down)
}

dev() {
  stop

  cp .env.dev .env
  copy_env

  (cd caddy-reverse-proxy && ./runner dev)
  (cd fitness-web && ./runner dev)
  (cd fitness-api && ./run)

  APP_URL=$(grep -m 1 '^APP_URL=' .env | cut -d '=' -f2- | tr -d '"' | tr -d "'")
  APP_PORT=$(grep -m 1 '^APP_PORT=' .env | cut -d '=' -f2- | tr -d '"' | tr -d "'")

  printf "\n\nFrontend:\t" 
  if [ -n "$APP_PORT" ]; then
    color cyan "${APP_URL}:${APP_PORT}"
  else
    color cyan "${APP_URL}"
  fi
  printf "\nEmail service:\t"
  color cyan "${APP_URL}:8025"
  printf "\n\n"
}

ensure_exec

case "$1" in
  (dev) dev;;
  (prod) prod;;
  (stop) stop;;
  (destroy) destroy;;
  (*) help;;
esac

exit 0
